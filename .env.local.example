# AWS Region
NEXT_PUBLIC_AWS_REGION=ap-northeast-1

# Amazon Location Service - Map Name
NEXT_PUBLIC_LOCATION_MAP_NAME=location-music-map

# Cognito Identity Pool ID
# 例: ap-northeast-1:12345678-1234-1234-1234-123456789012
NEXT_PUBLIC_AWS_IDENTITY_POOL_ID=

# 注意:
# - このファイルをコピーして .env.local を作成してください
# - .env.local は .gitignore に追加済みです（コミットしません）
# - AWS Location Serviceを使用する場合のみ必要です
# - 現在はOpenStreetMapを使用しているため、設定なしでも動作します
